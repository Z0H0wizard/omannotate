#!/bin/bash
# Copy this working tree into the live plugin folder, as `omarchy plugin add`
# would install it, then restart omarchy-shell: a running shell can keep the
# plugin code it loaded earlier. Pass --no-restart to only copy.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
target="$HOME/.config/omarchy/plugins/omannotate"

mkdir -p "$target"
# Only what would be published: files ignored by git (the local-only tests)
# are skipped, and earlier copies of them removed. A .git in the target stays.
rsync -a --delete --delete-excluded --filter='P /.git' --filter='- /.git' \
  --filter=':- .gitignore' "$root/" "$target/"
omarchy-plugin-validate "$target"
echo "Installed into $target"
[[ ${1-} == --no-restart ]] && exit 0

# The copy makes the shell reload its plugins. Restarting it in the middle of
# that can leave no shell running, so wait until it answers first.
ready() {
  for _ in $(seq 40); do
    omarchy-shell shell ping >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  return 1
}

sleep 1
ready || true
omarchy restart shell >/dev/null 2>&1 || true
if ! ready; then
  omarchy restart shell >/dev/null 2>&1 || true
  ready || { echo "omarchy-shell did not come back; run: omarchy restart shell" >&2; exit 1; }
fi

if omarchy-shell omannotate status >/dev/null 2>&1; then
  echo "omarchy-shell restarted with OmAnnotate running"
else
  echo "omarchy-shell restarted. Enable OmAnnotate once with: omarchy plugin enable omannotate"
fi
